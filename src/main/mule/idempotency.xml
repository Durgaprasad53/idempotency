			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="7b4ccbad-6a70-4775-a4ec-f0a8ffd24252" >
				<logger level="INFO" doc:name="Logger" doc:id="ef2c0679-4bb0-426d-ba2d-c75d672e3fb4" message="private-stopped" />
				<ee:transform doc:name="Transform Message" doc:id="fefc3928-0707-4ceb-9bcf-53a00396bb38" >
