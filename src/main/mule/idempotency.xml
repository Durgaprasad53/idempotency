		<raise-error doc:name="Raise error" doc:id="05d4e5b8-2a41-4d5e-a8d8-007ac621b309" type="APP:CUSTOM_ERROR" description="Customer validation failed" />
		<logger level="INFO" doc:name="Logger" doc:id="76ad8578-34ee-40bc-aa38-4df9894fb4e3" message="after-error"/>
		<ee:transform doc:name="Transform Message" doc:id="f6f73021-b2b9-481c-8c21-7f5ae63bede1" >
			<ee:message >
				<ee:set-payload ><![CDATA["private"]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler >
			<!-- [STUDIO:"On Error Continue"]<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e1ad1c4e-f540-4d7e-9b4f-4d4f10a6fd7b" >
				<logger level="INFO" doc:name="Logger" doc:id="3a068c8b-dbdf-4da3-a8b0-76203b642aaf" message="private-continue" />
				<ee:transform doc:name="Transform Message" doc:id="514c8c01-4368-4038-b547-f05901569542" >
					<ee:message >
						<ee:set-payload ><![CDATA["private-continue"&#93;&#93;></ee:set-payload>
